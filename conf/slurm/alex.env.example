# Copy this file to conf/slurm/alex.env on Alex and replace every path.
# This file is sourced by Bash; do not add spaces around '='.
VOXCPM_REPO_DIR=/path/on/alex/to/VoxCPM
VOXCPM_CONDA_ENV=voxcpm
VOXCPM_PYTHON_MODULE=python
VOXCPM_PRETRAINED_PATH=/path/on/alex/to/VoxCPM2
MALAYALAM_TRAIN_MANIFEST=/path/on/alex/to/malayalam_train.jsonl
MALAYALAM_VAL_MANIFEST=/path/on/alex/to/malayalam_val.jsonl
VOXCPM_RUN_DIR=/path/on/alex/to/runs/malayalam-pilot
VOXCPM_TRAIN_CONFIG=conf/voxcpm_v2/voxcpm_finetune_malayalam_lora.yaml

# Put Hugging Face caches on project/workspace storage, not in the repository.
HF_HOME=/path/on/alex/to/huggingface-cache
